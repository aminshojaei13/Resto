{
    "name": "calcuapp/backend",
    "type": "project",
    "description": "Calcuapp SaaS REST API Backend & Double-Entry Accounting Engine",
    "keywords": ["framework", "laravel", "saas", "pos", "accounting", "inventory"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0 || ^12.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "audit": {
            "block-on": []
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
