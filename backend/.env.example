APP_NAME=Resto
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- Database Configuration ---
# For Docker setup (PostgreSQL):
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=calcuapp
DB_USERNAME=postgres
DB_PASSWORD=secret

# For standalone local non-Docker setup (SQLite):
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# --- Redis Configuration ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Session & Cache & Queue Configuration ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=sync
