APP_NAME=Resto
APP_ENV=local
APP_KEY=base64:is7eBmQ8GWLfNC61sA32BGksUFhlwwe/S8lFTAwLQzw=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# --- Database Configuration ---
# Standalone local SQLite configuration for non-Docker development:
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# --- Redis Configuration ---
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Session & Cache & Queue Configuration ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- Frontend Origins (for CORS / email links) ---
# Comma-separated. Dev defaults below; production should list real domains.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# --- Optional / operational ---
AUTH_TOKEN_EXPIRATION_MINUTES=720
PASSWORD_RESET_EXPIRE_MINUTES=60
LOGIN_MAX_ATTEMPTS=10
LOGIN_DECAY_MINUTES=1
STAFF_INVITATION_HOURS=72
